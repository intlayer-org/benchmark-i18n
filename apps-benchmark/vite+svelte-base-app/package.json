{
  "name": "vite-svelte-base-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bunx --bun vite dev --port 3000",
    "build": "bunx --bun vite build",
    "preview": "bunx --bun vite preview --port 4173",
    "test": "bun run build && playwright test pages.test.ts && bun run test:components && playwright test rendering.test.ts && playwright test reactivity.test.ts",
    "test:components": "bun scripts/measure-svelte-components.ts",
    "test:consistency": "bun run build && bun run build:reference && PLAYWRIGHT_STRUCTURE=1 playwright test structure-consistency.test.ts",
    "build:reference": "cd ../vite+react-base-app && bun run build",
    "test:pages": "playwright test pages.test.ts",
    "test:reactivity": "playwright test reactivity.test.ts",
    "test:rendering": "playwright test rendering.test.ts",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "lucide-svelte": "^0.544.0",
    "tailwindcss": "^4.2.2",
    "test-utils": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.12.2",
    "bun": "^1.3.12",
    "svelte": "^5.55.4",
    "svelte-check": "^4.4.6",
    "typescript": "~6.0.2",
    "vite": "^8.0.10"
  }
}
