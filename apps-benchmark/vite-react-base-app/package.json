{
  "name": "vite-react-base-app",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "bun x --bun vite build",
    "dev": "bun x --bun vite dev --port 3000",
    "preview": "bun x --bun vite preview",
    "test": "bun test:pages && bun test:components && bun test:rendering && bun test:reactivity",
    "test:components": "bun scripts/measure-components.ts",
    "test:consistency": "playwright test structure-consistency.test.ts",
    "test:pages": "playwright test pages.test.ts",
    "test:reactivity": "playwright test reactivity.test.ts",
    "test:rendering": "playwright test rendering.test.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "1.170.33",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "1.168.50",
    "@tanstack/router-plugin": "^1.168.36",
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.14.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "bun": "^1.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "test-utils": "workspace:*",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
