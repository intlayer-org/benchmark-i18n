{
  "name": "vite-react-lingui-dynamic",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "bun x --bun vite build",
    "dev": "bun x --bun vite dev --port 3000",
    "preview": "bun x --bun vite preview",
    "test": "bun test:pages && bun test:components && bun test:rendering && bun test:reactivity",
    "test:components": "bun scripts/measure-components.ts",
    "test:consistency": "playwright test structure-consistency.test.ts",
    "test:pages": "playwright test pages.test.ts",
    "test:reactivity": "playwright test reactivity.test.ts",
    "test:rendering": "playwright test rendering.test.ts",
    "test:content": "playwright test content-consistency.test.ts",
    "compile": "lingui compile",
    "extract": "lingui extract"
  },
  "dependencies": {
    "@lingui/core": "^6.6.0",
    "@lingui/format-json": "^6.6.0",
    "@lingui/react": "^6.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.43.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.14.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@lingui/babel-plugin-lingui-macro": "^6.6.0",
    "@lingui/cli": "^6.6.0",
    "@lingui/vite-plugin": "^6.6.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "bun": "^1.4.2",
    "jsdom": "^30.0.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "test-utils": "workspace:*",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
