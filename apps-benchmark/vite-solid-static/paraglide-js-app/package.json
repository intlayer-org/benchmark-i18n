{
  "name": "vite-solid-paraglide-js-static",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "compile:paraglide": "node ./node_modules/@inlang/paraglide-js/bin/run.js compile --project ./project.inlang",
    "build": "bun run compile:paraglide && vite build",
    "dev": "bun x --bun vite dev --port 3000",
    "preview": "vite preview",
    "test": "bun test:pages && bun test:components && bun test:rendering && bun test:reactivity && bun test:lib-size",
    "test:components": "bun scripts/measure-components.ts",
    "test:lib-size": "bun scripts/measure-lib-size.ts",
    "test:pages": "playwright test pages.test.ts",
    "test:reactivity": "playwright test reactivity.test.ts",
    "test:rendering": "playwright test rendering.test.ts"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.17.0",
    "@solidjs/router": "^0.15.1",
    "@tailwindcss/vite": "^4.2.2",
    "solid-js": "^1.9.12",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@inlang/paraglide-vite": "^1.4.0",
    "@inlang/plugin-message-format": "^4",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^25.6.0",
    "bun": "^1.4.2",
    "test-utils": "workspace:*",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.12"
  }
}
