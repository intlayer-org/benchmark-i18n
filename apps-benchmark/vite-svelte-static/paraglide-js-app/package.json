{
  "name": "vite-svelte-paraglide-js-static",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "compile:paraglide": "node ./node_modules/@inlang/paraglide-js/bin/run.js compile --project ./project.inlang",
    "dev": "bun x --bun vite dev --port 3000",
    "build": "bun run compile:paraglide && vite build",
    "preview": "vite preview",
    "test": "bun run build && playwright test pages.test.ts && bun run test:components && playwright test rendering.test.ts && playwright test reactivity.test.ts && bun run test:lib-size",
    "test:components": "bun scripts/measure-svelte-components.ts",
    "test:lib-size": "bun scripts/measure-lib-size.ts",
    "test:pages": "playwright test pages.test.ts",
    "test:reactivity": "playwright test reactivity.test.ts",
    "test:rendering": "playwright test rendering.test.ts",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "lucide-svelte": "^1.0.1",
    "tailwindcss": "^4.3.3",
    "test-utils": "workspace:*"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.25.1",
    "@inlang/paraglide-vite": "^1.4.0",
    "@inlang/plugin-message-format": "^4",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26",
    "bun": "^1.4.2",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~7.0.2",
    "vite": "^8.2.2"
  }
}
