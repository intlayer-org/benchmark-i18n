#: src/components/pages/home/UnderstandingImpact.svelte
msgid "<0>Flash of untranslated content (FOUC):</0> users may briefly see translation keys or a fallback language before the chunk arrives."
msgstr "<0>Parpadeo de contenido no traducido (FOUC):</0> los usuarios pueden ver brevemente las claves de traducción o un idioma de respaldo antes de que llegue el fragmento."

#: src/components/pages/home/UnderstandingImpact.svelte
msgid "<0>Cache invalidation:</0> updating translations requires cache-busting strategies to ensure users get fresh content without re-downloading unchanged chunks."
msgstr "<0>Invalidación de la caché:</0> actualizar las traducciones requiere estrategias de invalidación de la caché para asegurar que los usuarios obtengan contenido fresco sin volver a descargar fragmentos no modificados."
