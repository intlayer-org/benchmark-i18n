msgid "<0>Flash of untranslated content (FOUC):</0> users may briefly see translation keys or a fallback language before the chunk arrives."
msgstr "<0>Flash de conteúdo não traduzido (FOUC):</0> usuários podem ver brevemente as chaves de tradução ou um idioma de fallback antes de o chunk chegar."

#: src/components/pages/home/UnderstandingImpact.svelte
